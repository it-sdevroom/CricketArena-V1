# Copy this file to .env and fill in the two values from your Supabase project
# (Project settings -> API). Restart with `npx expo start --clear` afterwards.
#
# The anon key is meant to be public: it is compiled into the app bundle and the
# web build. Row level security in supabase/migrations is what protects data.
# Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for GitHub Pages, where the site is served from a subpath.
# The deploy workflow sets this automatically; leave it blank for local dev.
# EXPO_PUBLIC_BASE_URL=/CricketArena
