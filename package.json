{
  "name": "cricket-arena",
  "version": "2.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/domain/__tests__/scoring.test.ts src/domain/__tests__/tournament.test.ts src/domain/__tests__/commentary.test.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "check": "npm run typecheck && npm run test && npm run verify:schema && npm run verify:combined",
    "export:web": "expo export --platform web --output-dir dist",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:web": "expo export --platform web --output-dir dist && node scripts/create-sites-worker.mjs",
    "verify:combined": "tsx scripts/verify-combined-sql.ts",
    "icons": "node scripts/generate-icons.mjs",
    "sql:build": "node scripts/build-setup-sql.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.20",
    "expo-blur": "~15.0.7",
    "expo-crypto": "~15.0.9",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/react": "~19.1.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}
